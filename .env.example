# LiteLLM proxy — ทางเดียวที่แอปคุยกับโมเดล (ขอ virtual key จากผู้ดูแล)
LLM_BASE_URL=http://localhost:4000/v1
LLM_API_KEY=
# ชื่อโมเดลที่ key นี้เรียกได้ คั่นด้วย , ตัวแรกเป็นค่าเริ่มต้น (ดูจาก GET /v1/models)
LLM_MODELS=flash
DB_ENGINE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
API_TOKEN=
